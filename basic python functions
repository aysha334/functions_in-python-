# say_hello() — Greeting Function
def say_hello():
    print("Hello, World!")

say_hello()
# add(a, b) — Addition Function
def add(a, b):
    print(a + b)

add(5, 3)
#check_number(number) — Even or Odd Function 
def check_number(number):
    if number % 2 == 0:
        print("Even number")
    else:
        print("Odd number")

check_number(7)
# find_largest(a, b) — Largest Number Function
def find_largest(a, b):
    if a > b:
        print(a, "is larger")
    else:
        print(b, "is larger")

find_largest(10, 20)
# square(number) — Square Function
def square(number):
    return number * number

result = square(4)
print(result)
